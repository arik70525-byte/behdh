name: Build APK
on: [push, workflow_dispatch]

permissions:
  contents: read
  actions: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v4
    - uses: actions/setup-java@v4
      with:
        java-version: '17'
        distribution: 'temurin'
        
    - name: Unzip and Find Manifest
      run: |
        unzip scanner_app.zip -d .
        echo "=========================================="
        echo "Ищем AndroidManifest.xml внутри проекта:"
        find . -name "AndroidManifest.xml"
        echo "=========================================="
        
    - name: Fix Theme
      run: |
        # Находим файл манифеста и меняем тему на встроенную
        MANIFEST_PATH=$(find . -name "AndroidManifest.xml" | grep -v build | head -n 1)
        echo "Правим файл: $MANIFEST_PATH"
        sed -i 's/@style\/Theme.AppCompat.Light.DarkActionBar/@android:style\/Theme.Material.Light.DarkActionBar/g' "$MANIFEST_PATH"
        
    - name: Grant execute permission for gradlew
      run: |
        # Переходим в папку, где лежит gradlew, и даем права
        GRADLEW_PATH=$(find . -name "gradlew" | head -n 1)
        GRADLEW_DIR=$(dirname "$GRADLEW_PATH")
        cd "$GRADLEW_DIR"
        chmod +x gradlew
        echo "Gradle лежит в: $GRADLEW_DIR"
        
    - name: Build with Gradle
      run: |
        GRADLEW_PATH=$(find . -name "gradlew" | head -n 1)
        GRADLEW_DIR=$(dirname "$GRADLEW_PATH")
        cd "$GRADLEW_DIR"
        ./gradlew assembleDebug
      
    - name: Upload APK
      uses: actions/upload-artifact@v4
      with:
        name: app-debug
        path: "**/build/outputs/apk/debug/app-debug.apk"
